generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  citizen
  admin
  collector
}

enum WasteType {
  PAPER_CARDBOARD
  PLASTIC
  METAL
  GLASS
  E_WASTE
  MIXED_RECYCLABLES
}

enum QuantityBand {
  SMALL
  MEDIUM
  LARGE
}

enum SlotPeriod {
  MORNING
  AFTERNOON
  EVENING
}

enum PickupStatus {
  requested
  assigned
  on_the_way
  arrived
  completed
  cancelled
  rejected
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(citizen)
  createdAt    DateTime @default(now()) @map("created_at")

  pickups                   Pickup[]           @relation("UserPickups")
  assignedPickups           Pickup[]           @relation("AdminAssignedPickups")
  assignedPickupAssignments PickupAssignment[] @relation("AdminAssignedPickupAssignments")
  vehicle                   Vehicle?           @relation("DriverVehicle")
  pointsLedger              PointsLedger[]
  userBadges                UserBadge[]
  rewardRedemptions         RewardRedemption[]

  @@map("users")
}

model Pickup {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  user            User         @relation("UserPickups", fields: [userId], references: [id])
  wasteType       WasteType    @map("waste_type")
  quantityBand    QuantityBand @map("quantity_band")
  wasteQuantity   Float?       @map("waste_quantity")
  address         String
  latitude        Float?
  longitude       Float?
  slotPeriod      SlotPeriod   @map("slot_period")
  requestedDate   DateTime     @map("requested_date") @db.Date
  status          PickupStatus @default(requested)
  rejectionReason String?      @map("rejection_reason")
  photoUrl        String?      @map("photo_url")
  assignedAdminId String?      @map("assigned_admin_id")
  assignedAdmin   User?        @relation("AdminAssignedPickups", fields: [assignedAdminId], references: [id])
  assignedAt      DateTime?    @map("assigned_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  pointsLedgerEntry PointsLedger?
  assignments       PickupAssignment[]

  @@index([userId, status])
  @@index([status])
  @@map("pickups")
}

model Vehicle {
  id             String    @id @default(uuid())
  registrationNo String    @unique @map("registration_no")
  type           String
  capacity       Float
  driverId       String?   @unique @map("driver_id")
  driver         User?     @relation("DriverVehicle", fields: [driverId], references: [id])
  isActive       Boolean   @default(true) @map("is_active")

  currentLat     Float?    @map("current_lat")
  currentLng     Float?    @map("current_lng")
  currentSpeed   Float?    @map("current_speed")
  currentHeading Float?    @map("current_heading")
  lastLocationAt DateTime? @map("last_location_at")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  assignments    PickupAssignment[]
  locations      VehicleLocation[]

  @@map("vehicles")
}

model PickupAssignment {
  id           String    @id @default(uuid())
  pickupId     String    @map("pickup_id")
  pickup       Pickup    @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  vehicleId    String    @map("vehicle_id")
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  assignedById String    @map("assigned_by_id")
  assignedBy   User      @relation("AdminAssignedPickupAssignments", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  startedAt    DateTime? @map("started_at")
  arrivedAt    DateTime? @map("arrived_at")
  completedAt  DateTime? @map("completed_at")
  unassignedAt DateTime? @map("unassigned_at")
  isActive     Boolean   @default(true) @map("is_active")

  @@index([pickupId, isActive])
  @@index([vehicleId, isActive])
  @@map("pickup_assignments")
}

model VehicleLocation {
  id         String   @id @default(uuid())
  vehicleId  String   @map("vehicle_id")
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  speed      Float    @default(0)
  heading    Float    @default(0)
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([vehicleId, recordedAt])
  @@map("vehicle_locations")
}

model PointsLedger {
  id           String   @id @default(uuid())
  pickupId     String   @unique @map("pickup_id")
  pickup       Pickup   @relation(fields: [pickupId], references: [id])
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  pointsEarned Int      @map("points_earned")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("points_ledger")
}

model Badge {
  id          String  @id @default(uuid())
  name        String  @unique
  minPoints   Int     @map("min_points")
  description String?

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String   @map("badge_id")
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now()) @map("earned_at")

  @@id([userId, badgeId])
  @@map("user_badges")
}

model Reward {
  id             String  @id @default(uuid())
  name           String
  pointsRequired Int     @map("points_required")
  stock          Int
  description    String?

  redemptions RewardRedemption[]

  @@map("rewards")
}

model RewardRedemption {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  rewardId       String   @map("reward_id")
  reward         Reward   @relation(fields: [rewardId], references: [id])
  pointsSpent    Int      @map("points_spent")
  redemptionCode String   @unique @map("redemption_code")
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  @@map("reward_redemptions")
}
