DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wastewise?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

REMINDER_THRESHOLD_DAYS=14

# Comma-separated list of allowed client origins, e.g.
# "http://localhost:5173,https://admin.wastewise.app". Leave unset in local
# dev to allow any origin.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# OSRM routing service (free public server or self-hosted)
OSRM_BASE_URL="https://router.project-osrm.org"

# Live tracking & Arrival verification radius (meters)
ARRIVAL_RADIUS_METERS=300

# Server-only development bypass flags (NEVER controlled by client requests)
DEV_SKIP="false"
DEV_SKIP_ARRIVAL_RADIUS="false"
