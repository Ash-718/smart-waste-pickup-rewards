# WasteWise Admin Dashboard Environment Variables
# API base URL pointing to the Express server
VITE_API_BASE_URL=http://localhost:4000/api

# WebSocket / Socket.IO server URL
VITE_SOCKET_BASE_URL=http://localhost:4000

# Contact email sent in HTTP User-Agent for OpenStreetMap Nominatim geocoding
VITE_CONTACT_EMAIL=your-email@example.com
