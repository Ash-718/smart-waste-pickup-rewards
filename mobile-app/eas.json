{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smart-waste-pickup-rewards.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://smart-waste-pickup-rewards.onrender.com",
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_CONTACT_EMAIL": "contact@wastewise.local",
        "EXPO_PUBLIC_TILE_URL": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

