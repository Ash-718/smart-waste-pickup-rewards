{
  "expo": {
    "name": "WasteWise",
    "slug": "wastewise-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pruthvi.wastewise",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "WasteWise uses your photos to attach a picture of the recyclables for your pickup request."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WasteWise needs your location to pinpoint pickup coordinates and enable live collection vehicle tracking.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "26fcdab0-950e-4aa4-a248-c518503822c0"
      }
    }
  }
}
