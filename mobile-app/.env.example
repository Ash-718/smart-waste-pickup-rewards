# Base URL for the WasteWise backend API.
# - iOS simulator / web: http://localhost:4000/api
# - Android emulator: http://10.0.2.2:4000/api (localhost inside the emulator is the emulator itself)
# - Physical device on the same network: http://<your-machine-LAN-IP>:4000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
